{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "reqvyn: build webview",
      "type": "shell",
      "command": "npx vite build",
      "options": { "cwd": "${workspaceFolder}/packages/ui" },
      "problemMatcher": []
    },
    {
      "label": "reqvyn: bundle extension",
      "type": "shell",
      "command": "node build.mjs",
      "options": { "cwd": "${workspaceFolder}/apps/vscode-extension" },
      "problemMatcher": []
    },
    {
      "label": "reqvyn: build extension",
      "dependsOrder": "sequence",
      "dependsOn": ["reqvyn: build webview", "reqvyn: bundle extension"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "reqvyn: test",
      "type": "shell",
      "command": "npx vitest run",
      "group": "test",
      "problemMatcher": []
    }
  ]
}

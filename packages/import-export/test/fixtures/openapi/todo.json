{
  "openapi": "3.1.0",
  "info": { "title": "Todo API", "version": "2.0.0" },
  "servers": [{ "url": "https://todo.example.test" }],
  "paths": {
    "/todos": {
      "get": {
        "operationId": "listTodos",
        "parameters": [{ "name": "done", "in": "query", "schema": { "type": "boolean" } }],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "operationId": "createTodo",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "type": "object", "properties": { "title": { "type": "string", "example": "Buy milk" } } }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/todos/{id}": {
      "patch": {
        "operationId": "updateTodo",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": { "application/json": { "example": { "done": true } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
